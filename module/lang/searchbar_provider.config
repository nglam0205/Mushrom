[main]
phraseStart=""".method private static startGlobalSearchByActivity"""
phraseEnd=""".end method"""
replaceWith="""
.method private static startGlobalSearchByActivity(Lcom/miui/home/launcher/BaseLauncher;Ljava/lang/String;Ljava/lang/String;IILandroid/view/View;)V
    .registers 10

    :try_start_0
    # check setting
    const-string v0, "vs_global_search_provider"
    invoke-static {v0}, Lcom/android/vsteam/Toolbox;->getBooleanGlobal(Ljava/lang/String;)Z
    move-result v0

    new-instance v1, Landroid/content/Intent;

    if-eqz v0, :cond_google

    # ===== MIUI SEARCH =====
    const-string v2, "com.android.miui.search"
    invoke-direct {v1, v2}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V

    const-string v2, "com.mi.globalminusscreen"
    invoke-virtual {v1, v2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;

    goto :cond_continue

    :cond_google
    # ===== GOOGLE SEARCH =====
    const-string v2, "android.search.action.GLOBAL_SEARCH"
    invoke-direct {v1, v2}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V

    const-string v2, "com.google.android.googlequicksearchbox"
    invoke-virtual {v1, v2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;

    # truyền query (Google mới cần)
    const-string v2, "query"
    invoke-virtual {v1, v2, p1}, Landroid/content/Intent;->putExtra(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;

    # optional target
    invoke-static {p2}, Landroid/text/TextUtils;->isEmpty(Ljava/lang/CharSequence;)Z
    move-result v2

    if-nez v2, :cond_continue

    const-string v2, "search_bar_target"
    invoke-virtual {v1, v2, p2}, Landroid/content/Intent;->putExtra(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;

    :cond_continue

    # flags chung
    const/high16 v2, 0x10200000
    invoke-virtual {v1, v2}, Landroid/content/Intent;->addFlags(I)Landroid/content/Intent;

    # animation bundle
    invoke-static {p5, p3, p4}, Lcom/miui/home/launcher/common/Utilities;->getGlobalSearchActivityLaunchOptionsAsBundle(Landroid/view/View;II)Landroid/os/Bundle;
    move-result-object v2

    invoke-virtual {p0, v1, v2}, Lcom/miui/home/launcher/BaseLauncher;->startActivity(Landroid/content/Intent;Landroid/os/Bundle;)V

    # tracking
    const/4 v2, 0x0
    invoke-static {v2}, Lcom/miui/home/launcher/overlay/search/OpenSearchUtil;->trackClickHomeSearchBoxSuccess(Z)V

    const/4 v2, 0x1
    sput-boolean v2, Lcom/miui/home/launcher/overlay/feed/FeedUtils;->isGlobalSearchActivityTop:Z

    :try_end_52
    .catch Ljava/lang/Exception; {:try_start_0 .. :try_end_52} :catch_53

    goto :goto_5a

    :catch_53
    const-string v0, "SearchOverlayUtil"
    const-string v1, "Global search activity not found"
    invoke-static {v0, v1}, Lcom/miui/home/common/MiuiHomeLog;->logE(Ljava/lang/String;Ljava/lang/String;)V

    :goto_5a
    return-void
.end method
"""