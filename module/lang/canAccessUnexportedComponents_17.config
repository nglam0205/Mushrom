[main]
phraseStart=""".method public static blacklist canAccessUnexportedComponents(I)Z"""
phraseEnd=""".end method"""
replaceWith="""
.method public static blacklist canAccessUnexportedComponents(I)Z
    .locals 2

    invoke-static {p0}, Landroid/os/UserHandle;->getAppId(I)I

    move-result v0

    if-eqz v0, :cond_allowed

    const/16 v1, 0x3e8

    if-eq v0, v1, :cond_allowed

    invoke-static {}, Lcom/android/vsteam/Toolbox;->getVsteamUid()I

    move-result v1

    if-ne v0, v1, :cond_denied

    :cond_allowed
    const/4 v0, 0x1

    return v0

    :cond_denied
    const/4 v0, 0x0

    return v0
.end method
"""
