[main]
phraseStart=""".method public static onGetKeyEntry"""
phraseEnd=""".end method"""
replaceWith="""
.method public static onGetKeyEntry(Landroid/system/keystore2/KeyEntryResponse;)Landroid/system/keystore2/KeyEntryResponse;
    .registers 6

    const/4 v0, 0x0

    if-nez p0, :has_response

    return-object v0

    :has_response
    iget-object v1, p0, Landroid/system/keystore2/KeyEntryResponse;->metadata:Landroid/system/keystore2/KeyMetadata;

    if-nez v1, :has_metadata

    return-object p0

    :has_metadata
    iget-object v2, v1, Landroid/system/keystore2/KeyMetadata;->certificate:[B

    if-nez v2, :has_certificate

    return-object p0

    :has_certificate
    const/4 v4, 0x0

    iget-object v3, v1, Landroid/system/keystore2/KeyMetadata;->key:Landroid/system/keystore2/KeyDescriptor;

    if-eqz v3, :no_alias

    iget-object v4, v3, Landroid/system/keystore2/KeyDescriptor;->alias:Ljava/lang/String;

    :no_alias
    sput-object v0, Lcom/android/vsteam/SubAttest;->algo:Ljava/lang/String;

    :try_start
    invoke-static {v2, v4}, Lcom/android/vsteam/Toolbox;->modifyOrSynthLeaf([BLjava/lang/String;)[B

    move-result-object v2

    if-eqz v2, :done

    sget-object v3, Lcom/android/vsteam/SubAttest;->algo:Ljava/lang/String;

    if-eqz v3, :done

    invoke-static {v3}, Lcom/android/vsteam/SubAttest;->getCertificateChain(Ljava/lang/String;)[B

    move-result-object v3

    if-eqz v3, :done

    iput-object v3, v1, Landroid/system/keystore2/KeyMetadata;->certificateChain:[B

    iput-object v2, v1, Landroid/system/keystore2/KeyMetadata;->certificate:[B
    :try_end
    .catchall {:try_start .. :try_end} :catchall

    goto :done

    :catchall
    move-exception v0

    :done
    return-object p0
.end method
"""
